{
  "name": "moni-tiku",
  "version": "1.38.0",
  "private": true,
  "description": "模拟题库 桌面版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "test": "vitest run"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.1",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "builder-util-runtime": "9.7.0",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.10.38"
  },
  "build": {
    "appId": "com.monitiku.app",
    "productName": "模拟题库",
    "copyright": "Copyright © 2026 JunGe Dev",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "legalTrademarks": "",
      "icon": "icons/icon.ico",
      "signAndEditExecutable": false
    },
    "extraResources": [
      {
        "from": "../模拟题库-Web版.html",
        "to": "app.html"
      }
    ],
    "asar": true,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "模拟题库",
      "language": "2052",
      "installerLanguages": [
        "zh_CN"
      ],
      "deleteAppDataOnUninstall": false,
      "artifactName": "MoniTiKu-Setup-${version}.${ext}",
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/lingsheng24/moni-tiku/releases/latest/download/",
        "channel": "latest"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "safeSave.js",
      "icons/**",
      "package.json",
      "!**/*.map",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/build/**"
    ],
    "afterPack": "./afterPack.js"
  }
}
